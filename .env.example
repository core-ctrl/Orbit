# Frontend build-time connection values. Set these to your deployed backend when hosting separately.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000
NEXT_PUBLIC_OBSERVABILITY_URL=http://localhost:8010

# Backend runtime security. Replace both values before exposing Orbit.
ORBIT_SECRET=replace-with-a-long-random-secret
ORBIT_ADMIN_PASSWORD=orbit
ORBIT_CORS_ORIGINS=http://localhost:3001
ORBIT_PUBLIC_URL=http://localhost:8000
ORBIT_FRONTEND_URL=http://localhost:3001

# Optional OAuth login. Leave blank until you create provider apps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SQLite is zero-config. Replace with postgresql://user:pass@host/db to use PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./data/orbit.db

# Optional Orbit Observability service for SDK ingest, issues, traces, replay, and sourcemaps.
OBSERVABILITY_DATABASE_URL=sqlite+aiosqlite:///./data/orbit-observability.db
ORBIT_OBSERVABILITY_ADMIN_TOKEN=replace-with-a-long-random-admin-token
OBSERVABILITY_CORS_ORIGINS=http://localhost:3001
