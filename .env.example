# Frontend build-time connection values. Set these to your deployed backend when hosting separately.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000

# Backend runtime security. Replace both values before exposing Orbit.
ORBIT_SECRET=replace-with-a-long-random-secret
ORBIT_ADMIN_PASSWORD=orbit
ORBIT_CORS_ORIGINS=http://localhost:3001

# SQLite is zero-config. Replace with postgresql://user:pass@host/db to use PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./data/orbit.db
